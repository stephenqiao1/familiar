{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "paths": {
      "@familiar/*": [
        "./packages/*/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.ts",
    "apps/*/scripts/**/*.ts"
  ]
}
